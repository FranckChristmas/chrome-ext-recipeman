{
  "manifest_version": 3,
  "name": "URL to Make",
  "version": "1.0",
  "description": "send the current website URL to Make via Webhook",
  "permissions": ["tabs", "activeTab", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Click to send URL"
  },
  "icons": {
    "48": "icon48.png"
  }
}
